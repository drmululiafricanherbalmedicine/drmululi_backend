NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:password@localhost:5432/drmululi?schema=public
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
CORS_ORIGIN=http://localhost:3000
