INITIAL_ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash

# Set these as Railway variables; never commit real values
ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-strong-password-at-least-12-characters
ADMIN_SETUP_KEY=generate-a-long-random-one-time-setup-key
